APP_NAME="La Victoria Bakery"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.example.invalid

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=la_victoria_staging
DB_USERNAME=la_victoria_staging
DB_PASSWORD=
DB_SSLMODE=disable

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=staging.example.invalid

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=no-reply@staging.example.invalid
MAIL_FROM_NAME="${APP_NAME} Staging"

FILESYSTEM_DISK=local
DEMO_USER_PASSWORD=

ARCA_ENABLED=false
ARCA_DRIVER=fake
ARCA_ENDPOINT=
ARCA_CERTIFICATE_PATH=

MERCADOPAGO_ENABLED=false
MERCADOPAGO_WEBHOOKS_ENABLED=false
MERCADOPAGO_DRIVER=fake
MERCADOPAGO_ENDPOINT=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

PWA_PUSH_ENABLED=false

IMPORT_DISK=local
IMPORT_MAX_BYTES=5242880
IMPORT_MAX_ROWS=5000
IMPORT_RETENTION_HOURS=72
PWA_PUSH_PUBLIC_KEY=
PWA_PUSH_PRIVATE_KEY=

OPS_WORKER_HEARTBEAT_MAX_AGE=180
OPS_SCHEDULER_HEARTBEAT_MAX_AGE=180
OPS_PENDING_NOTIFICATION_MAX_AGE=15
OPS_BACKUP_MANIFEST_DIRECTORY=
OPS_BACKUP_MAX_AGE_HOURS=4

STAGING_IMAGE_TAG=staging-local
STAGING_HTTP_BIND=127.0.0.1
STAGING_HTTP_PORT=8081
STAGING_MAILPIT_BIND=127.0.0.1
STAGING_MAILPIT_PORT=8026
