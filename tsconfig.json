{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["vite/client", "vite-plugin-pwa/client"]
    },
    "include": ["resources/js/**/*.ts", "resources/js/**/*.vue"]
}
